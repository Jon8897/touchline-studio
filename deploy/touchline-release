#!/usr/bin/env bash
# Installs a built release on this server, with a health check and automatic rollback.
# Installed as /usr/local/bin/touchline-release by server-setup.sh. The pipeline runs it as:
#   sudo touchline-release deploy  <staging|production> /home/deploy/incoming/touchline-<version>.tar.gz
# You can also run it by hand:
#   sudo touchline-release rollback <staging|production>     go back to the previous release
#   sudo touchline-release status   <staging|production>     show the live version and recent releases
set -euo pipefail
CMD="${1:-}"; ENV="${2:-}"; TARBALL="${3:-}"
case "$ENV" in production|staging) ;; *) echo "Environment must be 'production' or 'staging'"; exit 2;; esac
BASE=/srv/touchline/$ENV
SHARED=$BASE/shared
SVC=touchline@$ENV
PORT=$(grep -E '^PORT=' "$SHARED/.env" | cut -d= -f2 | tr -d '[:space:]')
[[ -n "$PORT" ]] || { echo "No PORT in $SHARED/.env"; exit 2; }

health() { # wait up to 20s for /healthz, optionally checking the version
  local want="${1:-}" body
  for _ in $(seq 1 20); do
    body=$(curl -fsS --max-time 2 "http://127.0.0.1:$PORT/healthz" 2>/dev/null || true)
    if [[ "$body" == *'"ok":true'* ]] && { [[ -z "$want" ]] || [[ "$body" == *"\"version\":\"$want\""* ]]; }; then echo "$body"; return 0; fi
    sleep 1
  done
  return 1
}
switch_to() { ln -sfn "$1" "$BASE/current.tmp" && mv -Tf "$BASE/current.tmp" "$BASE/current"; }

case "$CMD" in
deploy)
  [[ -f "$TARBALL" ]] || { echo "Release file not found: $TARBALL"; exit 2; }
  TS=$(date -u +%Y%m%d-%H%M%S)
  TMP=$(mktemp -d); tar -xzf "$TARBALL" -C "$TMP"
  VER=$(tr -d '[:space:]' < "$TMP/touchline/VERSION")
  DEST=$BASE/releases/$TS-$VER
  mv "$TMP/touchline" "$DEST"; rm -rf "$TMP"
  ln -sfn "$SHARED/data" "$DEST/data"; ln -sfn "$SHARED/backups" "$DEST/backups"; ln -sfn "$SHARED/.env" "$DEST/.env"
  chown -R root:root "$DEST"; chmod -R a+rX "$DEST"
  PREV=""; [[ -L "$BASE/current" ]] && PREV=$(readlink -f "$BASE/current")

  if [[ -n "$PREV" && -f "$SHARED/data/touchline.db" ]]; then
    echo "==> Backing up the $ENV database before updating"
    sudo -u touchline bash -c "cd '$PREV' && node --no-warnings=ExperimentalWarning admin.js backup '$SHARED/backups/pre-deploy-$TS.db'" >/dev/null
    find "$SHARED/backups" -name 'pre-deploy-*.db' -mtime +14 -delete || true
  fi

  echo "==> Switching $ENV to $VER"
  switch_to "$DEST"; systemctl restart "$SVC"
  if health "$VER"; then
    echo "==> $ENV is live on version $VER"
    ls -1d "$BASE"/releases/*/ | sort -r | tail -n +6 | xargs -r rm -rf   # keep the last 5 releases
    exit 0
  fi
  echo "!! Health check failed. Rolling back." >&2
  journalctl -u "$SVC" -n 30 --no-pager >&2 || true
  if [[ -n "$PREV" ]]; then switch_to "$PREV"; systemctl restart "$SVC"; health "" >/dev/null && echo "Rolled back to $(basename "$PREV")" >&2; fi
  rm -rf "$DEST"   # don't keep a release that failed its health check
  exit 1;;
rollback)
  CUR=$(readlink -f "$BASE/current")
  # the newest release that is older than the live one (release folders start with their date and time)
  PREV=$(ls -1d "$BASE"/releases/*/ | sed 's#/$##' | sort | awk -v cur="$CUR" '$0 < cur' | tail -1)
  [[ -n "$PREV" ]] || { echo "No earlier release to go back to."; exit 1; }
  switch_to "$PREV"; systemctl restart "$SVC"; health "" && echo "Rolled $ENV back to $(basename "$PREV")";;
status)
  echo "Live: $(basename "$(readlink -f "$BASE/current")")"; curl -fsS "http://127.0.0.1:$PORT/healthz" || echo "(not answering)"; echo
  echo "Releases:"; ls -1t "$BASE/releases";;
*) echo "Usage: touchline-release deploy|rollback|status <staging|production> [file]"; exit 2;;
esac
