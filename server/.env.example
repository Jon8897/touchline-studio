# Copy this file to .env and fill it in:  cp .env.example .env

# Which site this is: production (the live site) or staging (your test copy, shows a red banner and hides from Google)
APP_ENV=production

# Your public web address (with https://). Player links are built from this.
BASE_URL=https://touchline.example.com

# Where the database lives (the setup script fills this in)
DB_PATH=

# Show the "Beta · Feedback" badge to coaches (1 = yes, 0 = no)
BETA=1

# Bump this (e.g. 2027-01) whenever you change the Terms or Privacy policy: every coach is asked to agree again
TERMS_VERSION=2026-10

# Coaches must enter this code to create an account. Share it only with your test coaches.
# Leave empty to allow anyone to sign up.
SIGNUP_CODE=change-me

# How many active teams each new coach can have during the free test.
# Later this becomes "teams they have paid for".
FREE_TEAM_LIMIT=3

# Internal port the app listens on (Caddy forwards to it). Usually leave as is.
PORT=3000
HOST=127.0.0.1

# Assistant coaches allowed per team (they don't count towards the team limit).
MAX_ASSISTANTS=10

# ---------- Email (password resets, invites, welcome) ----------
# Who emails come from. Use an address on your own domain that your email provider has verified.
EMAIL_FROM=Touchline Studio <coach@yourdomain.com>
# Optional: where replies go.
EMAIL_REPLY_TO=

# Contact address shown on the website (footer, pricing, privacy page)
CONTACT_EMAIL=
# Where feedback, "report a concern" and privacy requests are emailed (defaults to CONTACT_EMAIL)
ADMIN_EMAIL=

# Pick ONE provider: console (just prints emails to the server log), resend, postmark or smtp
EMAIL_PROVIDER=console

# Resend (resend.com)
RESEND_API_KEY=

# Postmark (postmarkapp.com)
POSTMARK_TOKEN=

# Any SMTP service (Brevo, Mailgun, Amazon SES, Zoho, Google Workspace…)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for port 465 (SSL). Leave false for 587 (STARTTLS is used automatically).
SMTP_SECURE=false

# ---------- Payments (Stripe) ----------
# off = everyone gets the free-beta allowance (FREE_TEAM_LIMIT teams, everything unlocked). on = Free / Coach / Club plans.
PAYMENTS=off
# Test keys (sk_test_...) on staging, live keys (sk_live_...) on production only. The server refuses a live key on staging.
STRIPE_SECRET_KEY=
# The next lines are printed for you by:  node admin.js stripe-setup   (run once per site)
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_COACH_MONTHLY=
STRIPE_PRICE_COACH_YEARLY=
STRIPE_PRICE_CLUB_MONTHLY=
STRIPE_PRICE_EXTRA_TEAM_MONTHLY=
STRIPE_PRICE_EXTRA_TEAM_YEARLY=
STRIPE_FOUNDER_COUPON=
STRIPE_PORTAL_CONFIG=
# Free trial for a coach's first paid plan
TRIAL_DAYS=14
# Founding coaches (marked with: node admin.js founders --mark-all) keep full access free until this date, e.g. 2026-12-31
FOUNDER_GRACE_UNTIL=
